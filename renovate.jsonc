{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "group:allNonMajor"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "extends": ["schedule:weekly"]
    },
    "nix": {
        "enabled": true
    },
    "packageRules": [
        {
            "matchPackageNames": ["pdoc"],
            "groupName": "docs tooling"
        }
    ]
}
