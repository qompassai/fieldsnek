# Normalize text files
* text=auto
*.sh   text eol=lf
*.rb   text eol=lf
Fastfile text eol=lf
Appfile text eol=lf
*.[bB][aA][tT] text eol=crlf
*.[cC][mM][dD] text eol=crlf
*.svg text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.mp4  binary -delta

# *.psd filter=lfs diff=lfs merge=lfs -text

# *.md diff=markdown
.gitattributes export-ignore
.gitignore     export-ignore
docs/book/book/** export-ignore
fastlane/report.xml export-ignore
docs/book/book/** -whitespace
