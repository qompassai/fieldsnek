default_platform(:android)

FIELDSNEK_PACKAGE         = "com.qompassai.fieldsnek"
FIELDSNEK_BIN_DEFAULT     = "/var/tmp/buildozer/fieldsnek/bin"
FIELDSNEK_VERSION_DEFAULT = "2.0.0"

def resolve_aab(root)
  override = ENV["FIELDSNEK_AAB"]
  return override if override && File.exist?(override)

  bin_dir = ENV.fetch("FIELDSNEK_BIN_DIR", FIELDSNEK_BIN_DEFAULT)
  pattern = File.join(bin_dir, "fieldsnek-*-release.aab")
  matches = Dir.glob(pattern).sort_by { |f| File.mtime(f) }
  matches.last
end

def ensure_aab(root)
  existing = resolve_aab(root)
  if ENV["FIELDSNEK_SKIP_BUILD"] == "1" && existing && File.exist?(existing)
    UI.message("Reusing cached AAB: #{existing}")
    return existing
  end

  sh("bash #{root}/scripts/build-android.sh aab")
  aab = resolve_aab(root)
  UI.user_error!("FieldSnek AAB still missing after buildozer run (expected in #{FIELDSNEK_BIN_DEFAULT}/)") unless aab && File.exist?(aab)
  aab
end

def upload_with_bootstrap_hint(**opts)
  upload_to_play_store(**opts)
rescue => e
  msg = e.message.to_s
  if msg.include?("Package not found") || msg.include?("applicationNotFound")
    UI.error  "==============================================================="
    UI.error  "Play Console app not bootstrapped yet for FieldSnek."
    UI.error  ""
    UI.error  "The Play Developer API cannot create apps. You must do a one-"
    UI.error  "time manual upload through the Console UI before fastlane can"
    UI.error  "push releases:"
    UI.error  ""
    UI.error  "  1. https://play.google.com/console  (sign in as phaedrusflow)"
    UI.error  "  2. Create app  ->  App name: FieldSnek"
    UI.error  "                ->  Package name: #{FIELDSNEK_PACKAGE}"
    UI.error  "  3. Testing -> Internal testing -> Create new release"
    UI.error  "  4. Upload the AAB that just built:"
    UI.error  "       #{opts[:aab]}"
    UI.error  "  5. Save the draft (no rollout required)."
    UI.error  "  6. Users & permissions -> invite the service-account email"
    UI.error  "     from google-play-fieldsnek.json (Release to testing tracks)."
    UI.error  ""
    UI.error  "Full runbook: fastlane/INIT.md"
    UI.error  "==============================================================="
  end
  raise
end

platform :android do
  desc "Build FieldSnek AAB (buildozer) and upload to Closed Testing (API track 'alpha')"
  lane :closed do
    root = File.expand_path("..", __dir__)
    aab  = ensure_aab(root)

    opts = {
      aab: aab,
      track: ENV.fetch("FASTLANE_TRACK", "alpha"),
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true
    }
    upload_with_bootstrap_hint(**opts)
  end

  desc "Build FieldSnek AAB (buildozer) and upload to Internal testing (fastest review path)"
  lane :internal do
    root = File.expand_path("..", __dir__)
    aab  = ensure_aab(root)

    opts = {
      aab: aab,
      track: "internal",
      release_status: "draft",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true
    }
    upload_with_bootstrap_hint(**opts)
  end

  desc "Validate service-account credentials only (no build, no AAB needed)"
  lane :check_auth do
    json_key = File.expand_path(
      "#{ENV['XDG_CONFIG_HOME'] || "
    )
    validate_play_store_json_key(json_key: json_key)
  end

  desc "Build + dry-run upload (validate_only). Builds AAB then asks Google to validate it."
  lane :validate do
    root = File.expand_path("..", __dir__)
    aab  = ensure_aab(root)

    upload_with_bootstrap_hint(
      aab: aab,
      track: "internal",
      validate_only: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_apk: true
    )
  end
end
